# 只需配置连接和模型；表可在一个Excel工作簿中统一维护。
DAMENG_HOST=127.0.0.1
DAMENG_PORT=5236
DAMENG_USER=
DAMENG_PASSWORD=

TABLES_PATH=configs/tables.json
DESCRIPTIONS_DIR=configs/descriptions
ONTOLOGY_PATH=configs/ontology.json
INDEX_DIR=artifacts/index
AUDIT_PATH=artifacts/audit.jsonl
TIMEZONE=Asia/Shanghai

LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=your-chat-model
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# 留空复用LLM_*，问答模型必须支持工具调用。
QA_BASE_URL=
QA_MODEL=
QA_API_KEY=

# openai_compatible / ollama / vllm
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_API_KEY=
EMBEDDING_MODEL_REVISION=
EMBEDDING_EXPECTED_DIMENSION=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX=""
EMBEDDING_DOCUMENT_PREFIX=""

QUERY_TIMEOUT_SECONDS=30
METADATA_TIMEOUT_SECONDS=120
MAX_ROWS=100
MAX_RESPONSE_BYTES=262144
MAX_CONCURRENT_QUERIES=2

# 可选：设置后，catalog-sync不带--excel也会先导入这张工作簿。
DESCRIPTION_EXCEL=

# 业务MCP启动自举：只在索引缺失或过期时运行；范围必须固定，不能由问答模型临时扩大。
MCP_AUTO_BOOTSTRAP=false
MCP_AUTO_TABLES=
MCP_AUTO_SCHEMAS=
MCP_AUTO_INCLUDE=
MCP_AUTO_EXCLUDE=
MCP_AUTO_KEEP_EXISTING=false
MCP_AUTO_MAX_TABLES=50
MCP_AUTO_INVENTORY_PATH=artifacts/schema-inventory.json

# 独立管理型MCP启动门槛；留空时dm-admin-mcp拒绝启动。
MCP_ADMIN_TOKEN=
MCP_ADMIN_MAX_TABLES=200
MCP_ADMIN_OPERATION_TIMEOUT_SECONDS=900
